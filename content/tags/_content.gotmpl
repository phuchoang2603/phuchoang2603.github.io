{{/* Keep taxonomy paths intact; display only the leaf of topic/ and tech/ tags. */}}
{{ $tags := slice }}
{{ range resources.Match "tag-label-source/**" }}
  {{ if eq (path.Ext .Name) ".md" }}
    {{ $tags = $tags | append (partial "functions/front-matter-tags.html" .Content) }}
  {{ end }}
{{ end }}
{{ range $tag := $tags | uniq }}
  {{ $tagPath := lower $tag }}
  {{ if or (strings.HasPrefix $tagPath "topic/") (strings.HasPrefix $tagPath "tech/") }}
    {{ $leaf := index (last 1 (split $tag "/")) 0 }}
    {{ $.AddPage (dict "kind" "term" "path" $tagPath "title" $leaf "linkTitle" $leaf) }}
  {{ end }}
{{ end }}
